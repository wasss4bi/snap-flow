HTTP_PORT=8080
POSTGRES_PASSWORD=snapflow-local-password
RABBITMQ_PASSWORD=local-rabbit-password
RABBITMQ_PREFETCH=4
STORAGE_DRIVER=local
LOCAL_STORAGE_KEY=local-development-key-change-before-use
PARKING_REPLAY_INTERVAL_SECONDS=60
STORAGE_ENCRYPTION_KEY=
STORAGE_ENCRYPTION_KEY_VERSION=v1
STORAGE_PREVIOUS_ENCRYPTION_KEYS=
STORAGE_LEGACY_ENCRYPTION_KEY=
STORAGE_WRITE_LEGACY=false
JWT_SECRET=
SESSION_SECRET=local-session-key-change-before-use
TWS_ACCESS_KEY_ID=
TWS_SECRET_ACCESS_KEY=
TWS_BUCKET=
TWS_DEFAULT_REGION=ru-1
TWS_ENDPOINT=
S3_REQUEST_TIMEOUT_SECONDS=30

# Required for the administrator migration. Set local values in .env.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Local SMTP inbox; use real SMTP settings and TLS for actual delivery.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.test
SMTP_REQUIRE_TLS=false
PUBLIC_BASE_URL=http://localhost:8080
MAILPIT_PORT=8025

# Trusted reverse proxy addresses or CIDRs, comma-separated; empty trusts no proxy.
TRUSTED_PROXIES=

# Grafana and optional asynchronous Telegram alerts.
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=snapflow-local-admin
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional token for authenticated k6 read tests; use a dedicated test account.
K6_TOKEN=
