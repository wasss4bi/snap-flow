meta {
  name: Reject invalid image
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/upload-images
  body: multipartForm
  auth: none
}

headers {
  Authorization: Bearer {{jwt}}
  Idempotency-Key: {{$randomUUID}}
}

body:multipart-form {
  images: @file(fixtures/invalid.txt)
}

tests {
  test("HTTP 400", function () { expect(res.getStatus()).to.equal(400); });
  test("no false success",function(){expect(res.getBody().success).to.equal(false);});
}
