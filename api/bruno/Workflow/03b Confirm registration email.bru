meta {
  name: Confirm registration email
  type: http
  seq: 4
}
post {
  url: {{baseUrl}}/api/verify-email
  body: json
  auth: none
}
headers {
  Content-Type: application/json
}
body:json {
  {"email":"{{registrationEmail}}","code":"{{verificationToken}}"}
}
tests {
  test("email confirmed", function () { expect(res.getStatus()).to.equal(200); expect(res.getBody().success).to.equal(true); });
}
