meta {
  name: Read original
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/images/{{filename}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{jwt}}
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("binary content", function () { expect(res.getHeader('content-type')).to.contain('image/'); const data=res.getBody(); expect(data && (data.length || data.byteLength)).to.be.greaterThan(0); });
}
