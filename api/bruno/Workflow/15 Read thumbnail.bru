meta {
  name: Read thumbnail
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/thumbnails/{{filename}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{jwt}}
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("binary content", function () { expect(res.getHeader('content-type')).to.contain('image/jpeg'); const data=res.getBody(); expect(data && (data.length || data.byteLength)).to.be.greaterThan(0); });
}
