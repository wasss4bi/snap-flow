meta {
  name: Profile with explicit cookie
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/profile
  body: none
  auth: none
}

headers {
  Cookie: auth_token={{jwt}}
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("success", function () { expect(res.getBody().success).to.equal(true); });
}
