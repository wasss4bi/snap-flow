# Copy to .env on the server. Never commit real credentials.
HTTP_PORT=8080
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
DB_SSLMODE=disable
POSTGRES_DB=snap_flow
POSTGRES_USER=snap_flow
POSTGRES_PASSWORD=
